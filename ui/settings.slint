import { Button, CheckBox, Slider, LineEdit } from "std-widgets.slint";

export component SettingsWindow inherits Window {
    title: "Kısayolluk Ayarları";
    width: 480px;
    height: 580px;
    background: #0f172a;
    always-on-top: false;

    in-out property <bool> start_with_windows: false;
    in-out property <bool> app_enabled: true;
    in-out property <bool> show_tray_icon: true;
    in-out property <string> global_shortcut: "Ctrl+Shift+Space";
    in-out property <bool> double_right_click_enabled: true;
    in-out property <int> double_click_time_ms: 400;
    in-out property <int> jpeg_quality: 90;
    in-out property <int> collision_strategy_index: 0; // 0: Suffix, 1: Overwrite, 2: Skip

    callback save_clicked();
    callback cancel_clicked();

    VerticalLayout {
        padding: 24px;
        spacing: 16px;

        // Title Header
        HorizontalLayout {
            spacing: 12px;
            Text {
                text: "⚙️";
                font-size: 24px;
                vertical-alignment: center;
            }
            VerticalLayout {
                Text {
                    text: "Kısayolluk Ayarları";
                    font-size: 18px;
                    font-weight: 700;
                    color: #ffffff;
                }
                Text {
                    text: "Hızlı, hafif ve yerel radyal işlem aracı";
                    font-size: 11px;
                    color: #94a3b8;
                }
            }
        }

        // Section: Genel
        Rectangle {
            background: #1e293b;
            border-radius: 8px;
            border-width: 1px;
            border-color: #334155;

            VerticalLayout {
                padding: 12px;
                spacing: 8px;

                Text {
                    text: "GENEL";
                    font-size: 11px;
                    font-weight: 700;
                    color: #38bdf8;
                }

                CheckBox {
                    text: "Kısayolluk Aracını Etkinleştir";
                    checked <=> root.app_enabled;
                }

                CheckBox {
                    text: "Windows Açıldığında Başlat";
                    checked <=> root.start_with_windows;
                }

                CheckBox {
                    text: "Sistem Tepsisi Simgesini Göster";
                    checked <=> root.show_tray_icon;
                }
            }
        }

        // Section: Kısayollar & Algılama
        Rectangle {
            background: #1e293b;
            border-radius: 8px;
            border-width: 1px;
            border-color: #334155;

            VerticalLayout {
                padding: 12px;
                spacing: 8px;

                Text {
                    text: "KISAYOLLAR & ALGILAMA";
                    font-size: 11px;
                    font-weight: 700;
                    color: #38bdf8;
                }

                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: "Global Klavye Kısayolu:";
                        font-size: 12px;
                        color: #e2e8f0;
                        vertical-alignment: center;
                    }
                    LineEdit {
                        text <=> root.global_shortcut;
                        width: 160px;
                    }
                }

                CheckBox {
                    text: "Çift Sağ Tıklama ile Menüyü Aç";
                    checked <=> root.double_right_click_enabled;
                }

                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: "Çift Tıklama Aralığı (" + root.double_click_time_ms + " ms):";
                        font-size: 12px;
                        color: #e2e8f0;
                        vertical-alignment: center;
                    }
                    Slider {
                        minimum: 200;
                        maximum: 800;
                        value: root.double_click_time_ms;
                        changed(val) => { root.double_click_time_ms = Math.round(val); }
                    }
                }
            }
        }

        // Section: Görsel Dönüştürme
        Rectangle {
            background: #1e293b;
            border-radius: 8px;
            border-width: 1px;
            border-color: #334155;

            VerticalLayout {
                padding: 12px;
                spacing: 8px;

                Text {
                    text: "GÖRSEL DÖNÜŞTÜRME";
                    font-size: 11px;
                    font-weight: 700;
                    color: #38bdf8;
                }

                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: "JPEG Kalite Düzeyi (%" + root.jpeg_quality + "):";
                        font-size: 12px;
                        color: #e2e8f0;
                        vertical-alignment: center;
                    }
                    Slider {
                        minimum: 10;
                        maximum: 100;
                        value: root.jpeg_quality;
                        changed(val) => { root.jpeg_quality = Math.round(val); }
                    }
                }

                Text {
                    text: "PNG'den JPG'ye dönüşümde şeffaf alanlar beyaz arka plan ile doldurulur.";
                    font-size: 10px;
                    color: #94a3b8;
                }
            }
        }

        // Footer Action Buttons
        HorizontalLayout {
            alignment: end;
            spacing: 12px;

            Button {
                text: "İptal";
                clicked => { root.cancel_clicked(); }
            }

            Button {
                text: "Kaydet ve Uygula";
                primary: true;
                clicked => { root.save_clicked(); }
            }
        }
    }
}

